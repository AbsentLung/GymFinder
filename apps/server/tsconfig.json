{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "drizzle.config.ts", "vitest.integration.config.ts", "scripts/**/*.ts", "test/**/*.ts"],
  "exclude": ["server/**", "db/**", "node_modules"]
}
