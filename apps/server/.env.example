# Copy this file to .env and fill in real values. .env is gitignored -
# never commit real secrets.

# The NEW schema's database (src/db/schema.ts, drizzle.config.ts) - the
# Postgres+PostGIS container from docker-compose.yml at the repo root.
# Separate from (and never overwrites) the old demo `travelapp` database
# the server/*.js reference code below still uses directly.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/gymfinder

# Used by server/index.js's "Ask me questions about this gym" chat
# feature (including its web-search price lookup). Get a key at
# https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Signs the login session tokens issued by /api/auth/*. Any long random
# string works for local dev - generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Which LLM backend the chat/research/edit-verification features use.
# "anthropic" (default if unset) is the real path for production - costs
# real money per request, needs ANTHROPIC_API_KEY above. "ollama" runs a
# free local model instead (needs Ollama installed and running - see
# README's "Local AI (free, for development)" section) - noticeably
# less reliable at following tool-calling instructions than Anthropic's
# hosted model, which is the real tradeoff for $0 marginal cost.
AI_PROVIDER=anthropic
# Only read when AI_PROVIDER=ollama. Must already be pulled (`ollama pull <model>`).
OLLAMA_MODEL=qwen2.5:3b

# --- New server (apps/server/src/*) - MODE=demo|scale, read once at
# startup (src/config.ts). Below this line, these apply to the NEW
# server, not the legacy demo one above.

# Demo mode (default) uses the in-memory cache, pg-boss queue, and
# Ollama. Scale mode switches to Redis, BullMQ, and Claude - requires
# REDIS_URL and ANTHROPIC_API_KEY below to actually be set.
MODE=demo
REDIS_URL=redis://localhost:6379

# Better Auth's own env var name (it warns by this exact name if unset) -
# needed for correct OAuth callback/redirect URLs, not just a label.
BETTER_AUTH_URL=http://localhost:3001

# Google and Facebook sign-in (API.md 2.1) - optional. Leave unset in
# local dev until there's a real registered OAuth app for each; social
# sign-in just won't be offered until both clientId/clientSecret for a
# given provider are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
